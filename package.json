{
  "name": "vouchd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-only control panel for a Nostr human-bot hybrid community: register/authorize agents via NIP-OA, manage membership, watch presence. No backend server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "check:fn": "node scripts/check-function-length.mjs",
    "check": "npm run typecheck && npm run check:fn && npm run test"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.7.0",
    "idb": "^8.0.0",
    "nostr-tools": "^2.23.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.1"
  }
}
